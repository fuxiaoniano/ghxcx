<view class="enterprise-page detail-page" wx:if="{{doctor.id}}"><view class="doctor-hero enterprise-card"><image src="{{doctor.avatar}}" mode="aspectFill" /><view><view class="name">{{doctor.name}}</view><view class="title">{{doctor.title}}</view><view class="hospital">{{doctor.hospital}}</view></view></view><view class="enterprise-card"><view class="enterprise-section-title">擅长领域</view><view class="body-text">{{doctor.specialty}}</view></view><view class="enterprise-card"><view class="enterprise-section-title">医生简介</view><view class="body-text">{{doctor.description}}</view><swiper wx:if="{{doctor.images.length}}" class="doctor-images" indicator-dots><swiper-item wx:for="{{doctor.images}}" wx:key="*this"><image src="{{item}}" mode="aspectFill" /></swiper-item></swiper></view><view class="enterprise-card"><view class="enterprise-section-title">出诊信息</view><view wx:if="{{!doctor.schedules.length}}" class="enterprise-muted">暂无可预约出诊</view><view class="schedule-row" wx:for="{{doctor.schedules}}" wx:key="id"><view><text>{{item.date}}</text><text>{{item.timeSlot}}</text></view><text class="available">{{item.status==='AVAILABLE'?'可预约':'已满'}}</text></view></view><view class="enterprise-card consult-card"><view><view class="consult-title">在线咨询 一对一解答</view><view class="enterprise-muted">请问有什么可以帮助您的吗？</view></view><button open-type="contact" show-message-card>免费咨询</button></view><view class="bottom-actions"><button class="enterprise-button enterprise-button--outline" open-type="contact">在线咨询</button><button class="enterprise-button" bindtap="book">预约挂号</button></view></view>
