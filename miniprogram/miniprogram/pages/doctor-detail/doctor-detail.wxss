.detail-page{padding-bottom:150rpx}.doctor-hero{display:flex;align-items:center;gap:26rpx}.doctor-hero image{width:180rpx;height:210rpx;background:#eaf3ff;border-radius:18rpx}.doctor-hero .name{font-size:38rpx;font-weight:700}.doctor-hero .title{margin-top:10rpx;color:#3478f6}.display-text{margin-top:16rpx;color:#6c788a;font-size:24rpx}.body-text{color:#536176;line-height:1.8;white-space:pre-wrap}.doctor-images{height:360rpx;margin-top:24rpx}.doctor-images image{width:100%;height:100%;border-radius:16rpx}.clinic-name{margin-top:18rpx;font-weight:600}.clinic-address{margin-top:10rpx;color:#8a95a6;font-size:24rpx}.schedule-empty{margin-top:20rpx}.schedule-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16rpx;margin-top:24rpx}.schedule-day-card{min-width:0;padding:18rpx 16rpx;background:#f7f9fc;border:1rpx solid #e2e9f3;border-radius:16rpx;box-sizing:border-box}.day-head{display:flex;min-height:52rpx;align-items:flex-start;justify-content:space-between;padding-bottom:12rpx;border-bottom:1rpx solid #e6ecf4}.day-head>view{display:flex;min-width:0;align-items:baseline;gap:8rpx}.day-head strong{font-size:27rpx}.day-head text{color:#7e8999;font-size:21rpx}.today-tag{flex:0 0 auto!important;padding:3rpx 8rpx;color:#3478f6!important;background:#e7f0ff;border-radius:8rpx;font-size:19rpx!important}.schedule-slot{display:flex;min-height:72rpx;align-items:center;justify-content:space-between;color:#657287;font-size:23rpx}.schedule-button{width:88rpx;height:52rpx;margin:0;padding:0;color:#fff;background:#4d83ff;border:0;border-radius:26rpx;font-size:22rpx;line-height:52rpx}.schedule-button::after{border:0}.schedule-button.disabled{color:#a1a9b5;background:#e9edf3}.consult-card{display:flex;align-items:center;justify-content:space-between}.consult-title{font-weight:700}.consult-card button{margin:0;color:#fff;background:#3478f6;border-radius:34rpx;font-size:24rpx}.consult-card button::after{border:0}.bottom-actions{position:fixed;z-index:10;right:0;bottom:0;left:0;display:grid;grid-template-columns:1fr 1fr;gap:18rpx;padding:16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));background:#fff;box-shadow:0 -8rpx 24rpx rgba(34,60,96,.1)}.bottom-actions button{margin:0}
