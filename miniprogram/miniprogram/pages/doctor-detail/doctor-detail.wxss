.detail-page{padding-bottom:160rpx}.doctor-hero{display:flex;align-items:center;gap:28rpx;background:linear-gradient(180deg,#eaf3ff,#fff)}.doctor-hero image{width:190rpx;height:190rpx;background:#dceaff;border-radius:50%}.name{font-size:42rpx;font-weight:700}.title,.hospital{margin-top:14rpx;color:#536176}.body-text{color:#4f5e73;font-size:28rpx;line-height:1.8;white-space:pre-wrap}.doctor-images{height:360rpx;margin-top:24rpx}.doctor-images image{width:100%;height:100%;border-radius:16rpx}.schedule-row{display:flex;align-items:center;justify-content:space-between;padding:22rpx 0;border-top:1rpx solid #edf1f6}.schedule-row view{display:flex;gap:28rpx}.available{color:#16a77a}.consult-card{display:flex;align-items:center;justify-content:space-between}.consult-title{margin-bottom:12rpx;font-size:30rpx;font-weight:700}.consult-card button{margin:0;color:#fff;background:#3478f6;border-radius:40rpx}.bottom-actions{position:fixed;z-index:10;right:0;bottom:0;left:0;display:grid;grid-template-columns:1fr 1.5fr;gap:18rpx;padding:18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom));background:#fff;box-shadow:0 -8rpx 24rpx rgba(30,54,88,.1)}
