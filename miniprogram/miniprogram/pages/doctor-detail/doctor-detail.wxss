.detail-page{padding-bottom:150rpx}.doctor-hero{display:flex;align-items:center;gap:26rpx}.doctor-hero image{width:180rpx;height:210rpx;background:#eaf3ff;border-radius:18rpx}.doctor-hero .name{font-size:38rpx;font-weight:700}.doctor-hero .title{margin-top:10rpx;color:#3478f6}.display-text{margin-top:16rpx;color:#6c788a;font-size:24rpx}.body-text{color:#536176;line-height:1.8;white-space:pre-wrap}.doctor-images{height:360rpx;margin-top:24rpx}.doctor-images image{width:100%;height:100%;border-radius:16rpx}.clinic-name{margin-top:18rpx;font-weight:600}.clinic-address{margin-top:10rpx;color:#8a95a6;font-size:24rpx}.schedule-empty{margin-top:20rpx}.schedule-scroll{width:100%;margin-top:24rpx;white-space:nowrap}.schedule-grid{display:inline-flex;align-items:stretch;gap:12rpx;padding:2rpx 2rpx 8rpx}.schedule-day-card{display:flex;flex:0 0 164rpx;width:164rpx;flex-direction:column;overflow:hidden;padding:16rpx 10rpx;background:#f7f9fc;border:1rpx solid #e2e9f3;border-radius:16rpx;box-sizing:border-box}.day-head{display:flex;flex:0 0 76rpx;height:76rpx;flex-direction:column;align-items:center;justify-content:center;padding-bottom:10rpx;border-bottom:1rpx solid #e6ecf4;box-sizing:border-box}.day-head strong{font-size:26rpx}.day-head text{margin-top:4rpx;color:#3478f6;font-size:20rpx}.schedule-slot{display:flex;width:100%;height:96rpx;min-height:96rpx;flex:0 0 96rpx;flex-direction:column;align-items:center;justify-content:center;gap:8rpx;color:#657287;font-size:21rpx;line-height:1.2;box-sizing:border-box}.schedule-button{display:flex;width:132rpx;height:52rpx;min-height:52rpx;flex:0 0 52rpx;align-items:center;justify-content:center;color:#fff;background:#4d83ff;border-radius:26rpx;font-size:21rpx;line-height:1;text-align:center;box-sizing:border-box}.schedule-button>text{display:block;width:100%;line-height:52rpx;text-align:center}.schedule-button.disabled{color:#a1a9b5;background:#e9edf3}.consult-card{display:flex;align-items:center;justify-content:space-between}.consult-title{font-weight:700}.consult-card button{margin:0;color:#fff;background:#3478f6;border-radius:34rpx;font-size:24rpx}.consult-card button::after{border:0}.bottom-actions{position:fixed;z-index:10;right:0;bottom:0;left:0;display:grid;grid-template-columns:1fr 1fr;gap:18rpx;padding:16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));background:#fff;box-shadow:0 -8rpx 24rpx rgba(34,60,96,.1)}.bottom-actions button{margin:0}
