.detail-page{padding-bottom:150rpx}.doctor-hero{display:flex;align-items:center;gap:26rpx}.doctor-hero image{width:180rpx;height:210rpx;background:#eaf3ff;border-radius:18rpx}.doctor-hero .name{font-size:38rpx;font-weight:700}.doctor-hero .title{margin-top:10rpx;color:#3478f6}.display-text{margin-top:16rpx;color:#6c788a;font-size:24rpx}.body-text{color:#536176;line-height:1.8;white-space:pre-wrap}.doctor-images{height:360rpx;margin-top:24rpx}.doctor-images image{width:100%;height:100%;border-radius:16rpx}.clinic-name{margin-top:18rpx;font-weight:600}.clinic-address{margin-top:10rpx;color:#8a95a6;font-size:24rpx}.schedule-empty{margin-top:20rpx}.schedule-scroll{width:100%;margin-top:24rpx}.schedule-table{display:flex;min-width:max-content}.schedule-labels,.schedule-day{display:grid;grid-template-rows:80rpx 82rpx 82rpx;align-items:center;text-align:center}.schedule-labels{position:sticky;z-index:2;left:0;width:88rpx;color:#8a95a6;background:#fff}.schedule-day{width:112rpx}.day-head{display:flex;flex-direction:column;justify-content:center}.day-head strong{font-size:25rpx}.day-head text{margin-top:4rpx;color:#7e8999;font-size:21rpx}.schedule-button{width:76rpx;height:60rpx;margin:10rpx auto;padding:0;color:#fff;background:#4d83ff;border:0;border-radius:30rpx;font-size:23rpx;line-height:60rpx}.schedule-button::after{border:0}.schedule-button.disabled{color:#a1a9b5;background:#edf0f4}.consult-card{display:flex;align-items:center;justify-content:space-between}.consult-title{font-weight:700}.consult-card button{margin:0;color:#fff;background:#3478f6;border-radius:34rpx;font-size:24rpx}.consult-card button::after{border:0}.bottom-actions{position:fixed;z-index:10;right:0;bottom:0;left:0;display:grid;grid-template-columns:1fr 1fr;gap:18rpx;padding:16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));background:#fff;box-shadow:0 -8rpx 24rpx rgba(34,60,96,.1)}.bottom-actions button{margin:0}
