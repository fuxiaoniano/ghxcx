.package-head{display:flex;gap:22rpx;align-items:center}.package-head image{width:150rpx;height:130rpx;border-radius:14rpx}.package-head>view{font-size:29rpx;font-weight:650}.package-head strong{display:block;margin-top:18rpx;color:#ef4f43;font-size:36rpx}.picker-value{display:flex;align-items:center}.phone-ready{padding:24rpx;color:#167c61;background:#eaf8f4;border-radius:14rpx}.phone-button{margin-bottom:16rpx;color:#0071e3;background:#e8f2ff}.manual-row{display:grid;grid-template-columns:1fr 140rpx;gap:14rpx}.manual-row button{height:88rpx;color:#0071e3;background:#fff;border:1rpx solid #0071e3;border-radius:14rpx;line-height:86rpx}.privacy{display:flex;align-items:center;gap:14rpx;margin:30rpx 0;color:#5f6c80;font-size:24rpx}.checkbox{display:grid;width:36rpx;height:36rpx;place-items:center;border:2rpx solid #b6c1d0;border-radius:8rpx}.checkbox.checked{color:#fff;background:#0071e3;border-color:#0071e3}.tip{margin-top:24rpx;color:#6e6e73;font-size:23rpx;line-height:1.6;text-align:center}
