<view class="enterprise-page"><view wx:if="{{mode==='consultation'}}" class="enterprise-card"><view class="enterprise-section-title">暂无可同步的问诊记录</view><view class="enterprise-muted">在线咨询会话由微信客服能力承载，请在客服会话中查看历史消息。</view></view><view wx:elif="{{!records.length}}" class="enterprise-empty">暂无记录</view><view class="enterprise-card record-card" wx:for="{{records}}" wx:key="id"><view class="record-head"><strong>{{item.typeText}}</strong><text>{{item.statusText}}</text></view><view>编号：{{item.appointmentNo}}</view><view wx:if="{{item.doctor}}">医生：{{item.doctor.name}} {{item.doctor.title}}</view><view wx:if="{{item.package}}">套餐：{{item.package.title}}</view><view>预约：{{item.appointmentDate || '-'}} {{item.appointmentTime}}</view><view>提交时间：{{item.createdAt}}</view></view></view>
