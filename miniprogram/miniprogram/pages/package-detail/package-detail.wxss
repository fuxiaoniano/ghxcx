.package-detail-page{padding-top:0;padding-bottom:158rpx}.package-cover{width:calc(100% + 48rpx);height:430rpx;margin-left:-24rpx}.package-summary{position:relative;margin-top:-20rpx}.prices{display:flex;align-items:baseline;gap:16rpx}.prices strong{color:#ef4f43;font-size:48rpx}.prices del,.bottom-bar del{color:#8c96a7;text-decoration:line-through}.prices text{margin-left:auto;color:#6e6e73;font-size:22rpx}.title{margin-top:26rpx;font-size:34rpx;font-weight:700;line-height:1.5}.trust-row{display:grid;grid-template-columns:repeat(3,1fr);gap:8rpx;margin-top:24rpx;padding:20rpx 0;border-top:1rpx solid #edf1f6;border-bottom:1rpx solid #edf1f6}.trust-row>view{display:flex;align-items:center;justify-content:center;gap:8rpx;color:#56657a;font-size:23rpx}.trust-icon{display:grid;width:38rpx;height:38rpx;place-items:center;color:#0071e3;background:#e8f2ff;border-radius:50%;font-size:20rpx;font-weight:700}.notice{margin-top:20rpx;color:#6e6e73;font-size:24rpx;line-height:1.6}.description{color:#4f5e73;line-height:1.8;white-space:pre-wrap}.detail-image{display:block;width:100%;margin-bottom:16rpx}.bottom-bar{position:fixed;z-index:10;right:0;bottom:0;left:0;display:grid;grid-template-columns:minmax(180rpx,1fr) 116rpx 238rpx;align-items:center;gap:12rpx;padding:16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));background:#fff;box-shadow:0 -8rpx 24rpx rgba(30,54,88,.1)}.bottom-price{display:flex;min-width:0;flex-direction:column}.bottom-bar strong{color:#ef4f43;font-size:34rpx}.bottom-bar del{font-size:22rpx}.bottom-bar button{display:flex;width:100%;height:76rpx;align-items:center;justify-content:center;margin:0;padding:0;border-radius:38rpx;font-size:25rpx;line-height:normal}.bottom-bar button::after{border:0}.bottom-bar .consult{color:#0071e3;background:#e8f2ff}.bottom-bar .apply{color:#fff;background:#0071e3}
