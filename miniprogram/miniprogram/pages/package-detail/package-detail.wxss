.package-detail-page{padding-top:0;padding-bottom:150rpx}.package-cover{width:calc(100% + 48rpx);height:430rpx;margin-left:-24rpx}.package-summary{margin-top:-20rpx;position:relative}.prices{display:flex;align-items:baseline;gap:16rpx}.prices strong{color:#ef4f43;font-size:48rpx}.prices del{color:#8c96a7}.prices text{margin-left:auto;color:#6f7c91}.title{margin-top:26rpx;font-size:34rpx;font-weight:700;line-height:1.5}.notice{margin-top:22rpx;color:#6f7c91;font-size:24rpx;line-height:1.6}.description{color:#4f5e73;line-height:1.8;white-space:pre-wrap}.detail-image{display:block;width:100%;margin-bottom:16rpx}.bottom-bar{position:fixed;z-index:10;right:0;bottom:0;left:0;display:grid;grid-template-columns:1fr 110rpx 250rpx;align-items:center;gap:12rpx;padding:16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));background:#fff;box-shadow:0 -8rpx 24rpx rgba(30,54,88,.1)}.bottom-bar view{display:flex;flex-direction:column}.bottom-bar strong{color:#ef4f43;font-size:34rpx}.bottom-bar del{color:#8c96a7;font-size:22rpx}.bottom-bar button{width:100%;margin:0;border-radius:40rpx}.bottom-bar .apply{color:#fff;background:#3478f6}.bottom-bar button::after{border:0}
