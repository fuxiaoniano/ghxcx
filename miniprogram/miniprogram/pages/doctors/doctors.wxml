<view class="enterprise-page"><scroll-view class="filter-scroll" scroll-x><view class="filter-row"><view class="filter-chip {{departmentId===''?'active':''}}" data-id="" bindtap="selectDepartment">全部科室</view><view class="filter-chip {{departmentId===item.id?'active':''}}" wx:for="{{categories}}" wx:key="id" data-id="{{item.id}}" bindtap="selectDepartment">{{item.name}}</view></view></scroll-view><view wx:if="{{!loading&&!doctors.length}}" class="enterprise-empty">该科室暂无医生</view><view class="doctor-list-card" wx:for="{{doctors}}" wx:key="id" data-id="{{item.id}}" bindtap="openDetail"><view class="doctor-top"><image src="{{item.avatar}}" mode="aspectFill" /><view class="doctor-info"><view class="doctor-title">{{item.name}} <text>| {{item.title}}</text></view><view class="hospital">{{item.hospital || '重庆种博士口腔'}}</view></view><button catchtap="book" data-id="{{item.id}}">挂号</button></view><view class="specialty">擅长：{{item.specialty}}</view><view class="description">{{item.description}}</view></view></view>
