.filter-scroll{margin-bottom:24rpx;white-space:nowrap}.filter-row{display:inline-flex;gap:16rpx;padding:4rpx}.filter-chip{padding:18rpx 26rpx;color:#66748a;background:#fff;border:1rpx solid #e2e9f2;border-radius:36rpx}.filter-chip.active{color:#fff;background:#3478f6;border-color:#3478f6}.doctor-list-card{margin-bottom:22rpx;padding:28rpx;background:#fff;border-radius:20rpx}.doctor-top{display:flex;align-items:center;gap:20rpx}.doctor-top image{width:132rpx;height:132rpx;background:#eaf3ff;border-radius:18rpx}.doctor-info{min-width:0;flex:1}.doctor-title{font-size:32rpx;font-weight:700}.doctor-title text{color:#5f6c80;font-size:24rpx;font-weight:400}.hospital{margin-top:14rpx;color:#6e7b90;font-size:24rpx}.doctor-top button{width:112rpx;height:68rpx;padding:0;color:#3478f6;background:#fff;border:2rpx solid #3478f6;border-radius:14rpx;font-size:27rpx;line-height:64rpx}.doctor-top button::after{border:0}.specialty,.description{display:-webkit-box;margin-top:22rpx;overflow:hidden;color:#5e6b7f;font-size:26rpx;line-height:1.55;-webkit-box-orient:vertical}.specialty{-webkit-line-clamp:3}.description{color:#8a95a6;-webkit-line-clamp:2}
