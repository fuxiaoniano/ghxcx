page{background:#f5f8fc}.booking-page{min-height:calc(100vh - 100rpx);background:#fff}.booking-notice{padding:22rpx 28rpx;color:#9b6a16;background:#fff8e8;border-bottom:1rpx solid #f3dfb8;font-size:25rpx}.booking-columns{display:grid;height:calc(100vh - 200rpx);grid-template-columns:220rpx 1fr}.category-side{height:100%;background:#f3f6fb}.category-side-item{display:flex;min-height:104rpx;align-items:center;justify-content:center;padding:12rpx 20rpx;color:#6d798d;text-align:center;box-sizing:border-box}.category-side-item.active{position:relative;color:#3478f6;background:#fff;font-weight:700}.category-side-item.active::before{position:absolute;top:28rpx;bottom:28rpx;left:0;width:6rpx;background:#3478f6;border-radius:4rpx;content:""}.project-side{height:100%;padding:30rpx;box-sizing:border-box}.project-heading{margin-bottom:24rpx;font-size:34rpx;font-weight:700}.project-card{display:flex;min-height:116rpx;align-items:center;justify-content:space-between;margin-bottom:18rpx;padding:24rpx;background:#f8faff;border:1rpx solid #e5ecf5;border-radius:18rpx;box-sizing:border-box}.project-name{font-size:29rpx;font-weight:650}.project-desc{margin-top:10rpx;color:#8490a2;font-size:23rpx}.project-card>text{color:#3478f6;font-size:42rpx}
