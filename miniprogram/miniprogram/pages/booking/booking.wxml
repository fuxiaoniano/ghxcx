<view class="booking-page"><view class="booking-notice">可预约未来出诊时段，提交后以客服确认为准</view><view class="booking-columns"><scroll-view class="category-side" scroll-y><view class="category-side-item {{activeId===item.id?'active':''}}" wx:for="{{categories}}" wx:key="id" data-id="{{item.id}}" bindtap="selectCategory">{{item.name}}</view></scroll-view><scroll-view class="project-side" scroll-y><view class="project-heading">{{activeCategory.name || '请选择科室'}}</view><view class="project-card" wx:for="{{activeCategory.projects}}" wx:key="id" data-id="{{item.id}}" bindtap="selectProject"><view><view class="project-name">{{item.name}}</view><view class="project-desc">{{item.description || '查看该项目可预约医生'}}</view></view><text>›</text></view><view wx:if="{{activeCategory&&!activeCategory.projects.length}}" class="enterprise-empty">暂无可预约项目</view></scroll-view></view></view>
