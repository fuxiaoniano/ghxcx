.success-page{text-align:center}.success-mark{display:grid;width:132rpx;height:132rpx;margin:80rpx auto 28rpx;place-items:center;color:#fff;background:#16a77a;border-radius:50%;font-size:72rpx}.success-title{margin-bottom:16rpx;font-size:40rpx;font-weight:700}.detail{margin-top:48rpx;text-align:left}.detail view{display:flex;justify-content:space-between;padding:24rpx 0;border-bottom:1rpx solid #edf1f6}.detail view text:first-child{color:#6f7c91}.back-home{margin-top:18rpx;color:#3478f6;background:transparent}.back-home::after{border:0}
