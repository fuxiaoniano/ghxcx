page{background:#f5f8fc}.mall-page{min-height:calc(100vh - 100rpx);padding-top:18rpx}.mall-search{margin:0 24rpx 18rpx;padding:24rpx 32rpx;color:#768399;background:#fff;border-radius:44rpx}.mall-columns{display:grid;height:calc(100vh - 190rpx);grid-template-columns:190rpx 1fr}.mall-categories{height:100%;background:#f0f3f8}.mall-category{display:flex;min-height:100rpx;align-items:center;justify-content:center;padding:12rpx;color:#68758a;text-align:center;box-sizing:border-box}.mall-category.active{color:#3478f6;background:#fff;font-weight:700}.mall-list{height:100%;padding:0 20rpx 30rpx;background:#fff;box-sizing:border-box}.package-card{display:flex;gap:18rpx;padding:24rpx 0;border-bottom:1rpx solid #e9eef4}.package-card image{flex:0 0 170rpx;width:170rpx;height:170rpx;background:#eaf3ff;border-radius:14rpx}.package-copy{display:flex;min-width:0;flex:1;flex-direction:column}.package-title{display:-webkit-box;overflow:hidden;font-size:27rpx;font-weight:650;line-height:1.5;-webkit-box-orient:vertical;-webkit-line-clamp:2}.sales{margin-top:auto;color:#e78435;font-size:23rpx}.prices{display:flex;align-items:baseline;justify-content:flex-end;gap:8rpx}.original-price{color:#8c96a7;font-size:21rpx;text-decoration:line-through;text-decoration-color:#8c96a7;text-decoration-thickness:2rpx}.prices strong{color:#ef4f43;font-size:34rpx}
