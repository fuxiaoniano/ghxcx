page{background:#f5f8fc}.profile-page{min-height:100vh}.profile-hero{padding:60rpx 32rpx 80rpx;color:#fff;background:linear-gradient(145deg,#4f86ff,#2664dc)}.hospital-line{font-size:28rpx}.user-card{display:flex;align-items:center;gap:22rpx;margin-top:42rpx}.avatar{display:grid;width:104rpx;height:104rpx;place-items:center;color:#3478f6;background:#fff;border-radius:50%;font-size:40rpx;font-weight:700}.user-name{font-size:36rpx;font-weight:700}.user-phone{margin-top:10rpx;color:#dce8ff}.profile-body{margin-top:-42rpx;padding:0 24rpx 40rpx}.record-grid{display:grid;grid-template-columns:repeat(4,1fr);padding:28rpx 12rpx}.record-grid>view{display:flex;min-height:118rpx;flex-direction:column;align-items:center;justify-content:center;gap:12rpx;font-size:24rpx}.record-icon{display:grid;width:54rpx;height:54rpx;place-items:center;color:#3478f6;background:#eaf3ff;border-radius:18rpx;font-weight:700}.menu-card{padding:0 28rpx}.menu-row{display:flex;width:100%;min-height:96rpx;align-items:center;justify-content:space-between;margin:0;padding:0;color:#263247;background:#fff;border:0;border-bottom:1rpx solid #edf1f6;border-radius:0;font-size:28rpx;text-align:left}.menu-row::after{border:0}.menu-row text:last-child{color:#8c97a8;font-size:24rpx}.follow-card>view:first-child{margin-bottom:10rpx;font-size:30rpx;font-weight:700}.follow-card official-account{display:block;margin-top:22rpx}
