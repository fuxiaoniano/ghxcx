page{background:#f5f8fc}.profile-page{min-height:100vh;overflow:hidden}.profile-hero{padding:60rpx 32rpx 80rpx;color:#fff;background:linear-gradient(145deg,#4f86ff,#2664dc);box-sizing:border-box}.hospital-line{overflow:hidden;font-size:28rpx;text-overflow:ellipsis;white-space:nowrap}.user-card{display:flex;min-width:0;align-items:center;gap:22rpx;margin-top:42rpx}.avatar{display:grid;flex:0 0 104rpx;width:104rpx;height:104rpx;place-items:center;color:#3478f6;background:#fff;border-radius:50%;font-size:40rpx;font-weight:700}.user-info{min-width:0;flex:1}.user-name,.user-phone{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.user-name{font-size:36rpx;font-weight:700}.user-phone{margin-top:10rpx;color:#dce8ff}.profile-body{position:relative;margin-top:-42rpx;padding:0 24rpx calc(40rpx + env(safe-area-inset-bottom));box-sizing:border-box}.record-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:4rpx;padding:24rpx 8rpx}.record-grid>view{display:flex;min-width:0;min-height:124rpx;flex-direction:column;align-items:center;justify-content:center;gap:12rpx;padding:0 2rpx;font-size:23rpx;text-align:center;box-sizing:border-box}.record-grid>view>text:last-child{width:100%;white-space:nowrap}.record-icon{display:grid;width:54rpx;height:54rpx;place-items:center;color:#3478f6;background:#eaf3ff;border-radius:18rpx;font-weight:700}.menu-card{overflow:hidden;padding:0}.menu-row{display:block;width:100%;height:100rpx;min-height:100rpx;margin:0;padding:0;color:#263247;background:#fff;border:0;border-bottom:1rpx solid #edf1f6;border-radius:0;font-size:28rpx;font-weight:400;line-height:normal;text-align:left;box-sizing:border-box}.menu-row:last-child{border-bottom:0}.menu-row::after{border:0}.menu-row-content{display:flex;width:100%;height:100%;align-items:center;justify-content:space-between;padding:0 28rpx;box-sizing:border-box}.menu-row-content text:first-child{min-width:0;flex:1}.menu-row-content text:last-child{flex:0 0 auto;margin-left:20rpx;color:#8c97a8;font-size:28rpx}.follow-card>view:first-child{margin-bottom:10rpx;font-size:30rpx;font-weight:700}.follow-card official-account{display:block;margin-top:22rpx}
