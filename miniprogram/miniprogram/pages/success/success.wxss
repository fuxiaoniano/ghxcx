.page {
  min-height: 100vh;
  padding: 70rpx 32rpx;
  box-sizing: border-box;
  background: #fff8f2;
}

.success-icon {
  width: 120rpx;
  height: 120rpx;
  line-height: 120rpx;
  margin: 0 auto;
  text-align: center;
  color: #ffffff;
  background: #e91510;
  border-radius: 50%;
  font-size: 72rpx;
  font-weight: 800;
}

.title {
  margin-top: 28rpx;
  text-align: center;
  font-size: 42rpx;
  font-weight: 800;
}

.desc {
  margin: 18rpx auto 36rpx;
  max-width: 620rpx;
  text-align: center;
  color: #6a625e;
  font-size: 28rpx;
  line-height: 1.6;
}

.detail-card {
  margin-bottom: 36rpx;
  padding: 12rpx 28rpx;
  background: #ffffff;
  border-radius: 12rpx;
  box-shadow: 0 12rpx 30rpx rgba(120, 70, 45, 0.1);
}

.row {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f0e7df;
  color: #333;
  font-size: 28rpx;
}

.row:last-child {
  border-bottom: 0;
}

.row text:first-child {
  color: #8b817a;
}

.back-button {
  margin-top: 18rpx;
  color: #8a5f3d;
  background: transparent;
  font-size: 30rpx;
}
