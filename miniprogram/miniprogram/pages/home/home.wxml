<view class="enterprise-page home-page">
  <swiper wx:if="{{home.banners.length}}" class="hero-swiper" autoplay circular interval="4500" indicator-dots indicator-color="rgba(255,255,255,.55)" indicator-active-color="#ffffff"><swiper-item wx:for="{{home.banners}}" wx:key="id"><image class="hero-image" src="{{item.imageUrl}}" mode="aspectFill" data-index="{{index}}" bindtap="openBanner" /></swiper-item></swiper>
  <view class="quick-grid enterprise-card"><view class="quick-item" bindtap="goBooking"><view class="quick-icon">+</view><text>预约挂号</text></view><view class="quick-item" bindtap="goDoctors"><view class="quick-icon">医</view><text>医生团队</text></view><button class="quick-item quick-contact" open-type="contact" show-message-card><view class="quick-icon">询</view><text>免费咨询</text></button></view>
  <view wx:if="{{home.categories.length}}" class="enterprise-card category-panel"><view class="category-grid"><view class="category-item" wx:for="{{home.categories}}" wx:key="id" data-id="{{item.id}}" bindtap="openCategory" hover-class="category-item--pressed" aria-role="button" aria-label="{{item.name}}"><view class="category-icon"><image wx:if="{{item.icon}}" src="{{item.icon}}" mode="aspectFit" lazy-load aria-label="{{item.name}}" /><image wx:else src="/assets/category-restoration.svg" mode="aspectFit" aria-label="{{item.name}}" /></view><text>{{item.name}}</text></view></view></view>
  <swiper wx:if="{{home.ads.length}}" class="ad-swiper" autoplay circular interval="5000" indicator-dots indicator-color="rgba(255,255,255,.55)" indicator-active-color="#ffffff"><swiper-item wx:for="{{home.ads}}" wx:key="id"><image class="ad-image" src="{{item.imageUrl}}" mode="aspectFill" /></swiper-item></swiper>
  <view class="enterprise-card"><view class="section-heading"><view class="enterprise-section-title">医生推荐</view><text bindtap="goDoctors">全部医生 ›</text></view><view wx:if="{{!home.doctors.length}}" class="enterprise-empty">暂无推荐医生</view><view class="doctor-card" wx:for="{{home.doctors}}" wx:key="id" data-id="{{item.id}}" bindtap="openDoctor"><image class="doctor-avatar" src="{{item.avatar}}" mode="aspectFill" /><view class="doctor-main"><view class="doctor-name">{{item.name}} <text>{{item.title}}</text></view><view class="doctor-specialty">擅长：{{item.specialty}}</view></view><button class="book-small" catchtap="bookDoctor" data-id="{{item.id}}">挂号</button></view></view>
</view>
