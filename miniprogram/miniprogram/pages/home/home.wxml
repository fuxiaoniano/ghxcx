<view class="enterprise-page home-page">
  <view class="brand-block">
    <image wx:if="{{home.config.logo}}" class="brand-logo" src="{{home.config.logo}}" mode="aspectFit" />
    <view><view class="brand-name">{{home.config.hospitalName}}</view><view class="brand-slogan">{{home.config.slogan}}</view></view>
  </view>
  <swiper wx:if="{{home.banners.length}}" class="hero-swiper" autoplay circular indicator-dots indicator-active-color="#3478F6"><swiper-item wx:for="{{home.banners}}" wx:key="id"><image class="hero-image" src="{{item.imageUrl}}" mode="aspectFill" data-index="{{index}}" bindtap="openBanner" /></swiper-item></swiper>
  <view wx:else class="hero-fallback"><view class="hero-title">专业口腔诊疗服务</view><view class="hero-copy">医生团队 · 科学诊疗 · 便捷预约</view><button class="hero-button" bindtap="goBooking">立即预约</button></view>
  <view class="quick-grid enterprise-card"><view class="quick-item" bindtap="goBooking"><view class="quick-icon">+</view><text>预约挂号</text></view><view class="quick-item" bindtap="goDoctors"><view class="quick-icon">医</view><text>医生团队</text></view><view class="quick-item" bindtap="goBooking"><view class="quick-icon">科</view><text>科室项目</text></view></view>
  <view class="enterprise-card"><view class="enterprise-section-title">口腔治疗项目</view><view class="category-grid"><view class="category-item" wx:for="{{home.categories}}" wx:key="id" data-id="{{item.id}}" bindtap="openCategory"><image wx:if="{{item.icon}}" src="{{item.icon}}" mode="aspectFit" /><view wx:else class="category-placeholder">牙</view><text>{{item.name}}</text></view></view></view>
  <swiper wx:if="{{home.ads.length}}" class="ad-swiper" autoplay circular indicator-dots><swiper-item wx:for="{{home.ads}}" wx:key="id"><image class="ad-image" src="{{item.imageUrl}}" mode="aspectFill" /></swiper-item></swiper>
  <view class="enterprise-card"><view class="section-heading"><view class="enterprise-section-title">医生推荐</view><text bindtap="goDoctors">全部医生 ›</text></view><view wx:if="{{!home.doctors.length}}" class="enterprise-empty">暂无推荐医生</view><view class="doctor-card" wx:for="{{home.doctors}}" wx:key="id" data-id="{{item.id}}" bindtap="openDoctor"><image class="doctor-avatar" src="{{item.avatar}}" mode="aspectFill" /><view class="doctor-main"><view class="doctor-name">{{item.name}} <text>{{item.title}}</text></view><view class="doctor-specialty">擅长：{{item.specialty}}</view></view><button class="book-small" catchtap="bookDoctor" data-id="{{item.id}}">挂号</button></view></view>
</view>
