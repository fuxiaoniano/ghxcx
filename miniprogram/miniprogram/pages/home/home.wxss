.home-page{padding-top:18rpx}.brand-block{display:flex;align-items:center;gap:18rpx;padding:16rpx 8rpx 24rpx}.brand-logo{width:76rpx;height:76rpx}.brand-name{font-size:36rpx;font-weight:700}.brand-slogan{margin-top:6rpx;color:#6f7c91;font-size:24rpx}.hero-swiper,.hero-fallback{height:330rpx;margin-bottom:24rpx;border-radius:24rpx;overflow:hidden}.hero-slide{position:relative;width:100%;height:100%;overflow:hidden;background:#2872d8}.hero-slide::after{position:absolute;inset:0;background:linear-gradient(90deg,rgba(8,66,152,.72),rgba(27,112,213,.2) 58%,rgba(255,255,255,0));content:""}.hero-image,.ad-image{width:100%;height:100%}.hero-caption{position:absolute;z-index:1;top:58rpx;left:38rpx;width:58%;color:#fff;text-shadow:0 2rpx 8rpx rgba(7,48,104,.24)}.hero-caption .hero-title{font-size:40rpx;line-height:1.3}.hero-caption .hero-copy{margin-top:14rpx;font-size:25rpx}.hero-link{display:inline-flex;margin-top:32rpx;padding:11rpx 24rpx;background:rgba(255,255,255,.2);border:1rpx solid rgba(255,255,255,.55);border-radius:28rpx;font-size:23rpx}.hero-fallback{padding:58rpx 42rpx;color:#fff;background:linear-gradient(135deg,#4d88ff,#1557c0);box-sizing:border-box}.hero-title{font-size:42rpx;font-weight:700}.hero-copy{margin-top:20rpx}.hero-button{width:220rpx;margin:38rpx 0 0;color:#2470e9;background:#fff;border-radius:40rpx;font-size:27rpx}.quick-grid{display:grid;grid-template-columns:repeat(3,1fr);padding:24rpx 12rpx}.quick-item{display:flex;min-height:120rpx;flex-direction:column;align-items:center;justify-content:center;gap:10rpx;font-size:26rpx}.quick-icon{display:grid;width:58rpx;height:58rpx;place-items:center;color:#3478f6;background:#eaf3ff;border-radius:18rpx;font-weight:700}.category-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:28rpx 12rpx}.category-item{display:flex;min-height:132rpx;flex-direction:column;align-items:center;gap:12rpx;text-align:center;font-size:24rpx}.category-item image,.category-placeholder{width:68rpx;height:68rpx}.category-placeholder{display:grid;place-items:center;color:#3478f6;background:#eaf3ff;border-radius:50%;font-weight:700}.ad-swiper{height:220rpx;margin-bottom:24rpx;border-radius:20rpx;overflow:hidden}.section-heading{display:flex;align-items:center;justify-content:space-between;color:#3478f6}.doctor-card{display:flex;align-items:center;gap:20rpx;padding:24rpx 0;border-top:1rpx solid #edf1f6}.doctor-avatar{flex:0 0 112rpx;width:112rpx;height:112rpx;background:#eaf3ff;border-radius:18rpx}.doctor-main{min-width:0;flex:1}.doctor-name{font-size:30rpx;font-weight:700}.doctor-name text{margin-left:8rpx;color:#657287;font-size:24rpx;font-weight:400}.doctor-specialty{display:-webkit-box;margin-top:12rpx;overflow:hidden;color:#69768a;font-size:24rpx;line-height:1.5;-webkit-box-orient:vertical;-webkit-line-clamp:2}.book-small{flex:0 0 112rpx;width:112rpx;height:66rpx;padding:0;color:#3478f6;background:#fff;border:2rpx solid #3478f6;border-radius:34rpx;font-size:26rpx;line-height:62rpx}.book-small::after{border:0}
.home-page{padding-top:0}
.category-panel{padding:28rpx 12rpx 24rpx}.category-grid{grid-template-columns:repeat(5,minmax(0,1fr));gap:22rpx 4rpx}.category-item{min-width:0;min-height:118rpx;gap:10rpx;padding:4rpx 0;border-radius:14rpx;transition:background-color 160ms ease,opacity 160ms ease}.category-item--pressed{background:#f2f7ff;opacity:.72}.category-icon{display:grid;width:68rpx;height:68rpx;place-items:center;background:#eaf3ff;border-radius:50%}.category-item .category-icon image{width:44rpx;height:44rpx}.category-item text{width:100%;overflow:hidden;color:#172033;font-size:23rpx;line-height:1.35;text-align:center;text-overflow:ellipsis;white-space:nowrap}
.quick-grid{grid-template-columns:repeat(3,minmax(0,1fr));align-items:stretch;padding:0 8rpx}.quick-item{position:relative;display:flex;width:100%;height:96rpx;min-width:0;min-height:96rpx;flex-direction:row;align-items:center;justify-content:center;gap:8rpx;padding:0 4rpx;color:#172033;font-size:26rpx;font-weight:400;line-height:1.4;box-sizing:border-box}.quick-item text{display:block;white-space:nowrap}.quick-icon{display:grid;flex:0 0 52rpx;width:52rpx;height:52rpx;place-items:center;border-radius:14rpx;font-size:26rpx;font-weight:700;line-height:1}.quick-contact-hit{position:absolute;z-index:2;top:0;right:0;bottom:0;left:0;width:100%;height:100%;margin:0;padding:0;opacity:0;border:0}.quick-contact-hit::after{border:0}
