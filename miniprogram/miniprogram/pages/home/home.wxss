.home-page{padding-top:18rpx}.brand-block{display:flex;align-items:center;gap:18rpx;padding:16rpx 8rpx 24rpx}.brand-logo{width:76rpx;height:76rpx}.brand-name{font-size:36rpx;font-weight:700}.brand-slogan{margin-top:6rpx;color:#6f7c91;font-size:24rpx}.hero-swiper,.hero-fallback{height:330rpx;margin-bottom:24rpx;border-radius:24rpx;overflow:hidden}.hero-image,.ad-image{width:100%;height:100%}.hero-fallback{padding:58rpx 42rpx;color:#fff;background:linear-gradient(135deg,#4d88ff,#1557c0);box-sizing:border-box}.hero-title{font-size:42rpx;font-weight:700}.hero-copy{margin-top:20rpx}.hero-button{width:220rpx;margin:38rpx 0 0;color:#2470e9;background:#fff;border-radius:40rpx;font-size:27rpx}.quick-grid{display:grid;grid-template-columns:repeat(3,1fr);padding:24rpx 12rpx}.quick-item{display:flex;min-height:120rpx;flex-direction:column;align-items:center;justify-content:center;gap:10rpx;font-size:26rpx}.quick-icon{display:grid;width:58rpx;height:58rpx;place-items:center;color:#3478f6;background:#eaf3ff;border-radius:18rpx;font-weight:700}.category-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:28rpx 12rpx}.category-item{display:flex;min-height:132rpx;flex-direction:column;align-items:center;gap:12rpx;text-align:center;font-size:24rpx}.category-item image,.category-placeholder{width:68rpx;height:68rpx}.category-placeholder{display:grid;place-items:center;color:#3478f6;background:#eaf3ff;border-radius:50%;font-weight:700}.ad-swiper{height:220rpx;margin-bottom:24rpx;border-radius:20rpx;overflow:hidden}.section-heading{display:flex;align-items:center;justify-content:space-between;color:#3478f6}.doctor-card{display:flex;align-items:center;gap:20rpx;padding:24rpx 0;border-top:1rpx solid #edf1f6}.doctor-avatar{flex:0 0 112rpx;width:112rpx;height:112rpx;background:#eaf3ff;border-radius:18rpx}.doctor-main{min-width:0;flex:1}.doctor-name{font-size:30rpx;font-weight:700}.doctor-name text{margin-left:8rpx;color:#657287;font-size:24rpx;font-weight:400}.doctor-specialty{display:-webkit-box;margin-top:12rpx;overflow:hidden;color:#69768a;font-size:24rpx;line-height:1.5;-webkit-box-orient:vertical;-webkit-line-clamp:2}.book-small{flex:0 0 112rpx;width:112rpx;height:66rpx;padding:0;color:#3478f6;background:#fff;border:2rpx solid #3478f6;border-radius:34rpx;font-size:26rpx;line-height:62rpx}.book-small::after{border:0}
