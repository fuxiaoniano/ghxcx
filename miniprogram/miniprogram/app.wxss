page {
  min-height: 100vh;
  background: #f5f5f7;
  color: #1d1d1f;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", Helvetica, Arial, sans-serif;
}

button { border-radius: 44rpx; }

.primary-button {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  color: #ffffff;
  font-size: 34rpx;
  font-weight: 700;
  border: 0;
  background: #0071e3;
  border-radius: 48rpx;
}

.primary-button[disabled] {
  opacity: 0.7;
}

/* 企业官网新增页面专用命名空间，避免影响旧挂号页面。 */
.enterprise-page {
  min-height: 100vh;
  padding: 24rpx 24rpx calc(40rpx + env(safe-area-inset-bottom));
  color: #1d1d1f;
  background: #f5f5f7;
  box-sizing: border-box;
}

.enterprise-card {
  margin-bottom: 24rpx;
  padding: 28rpx;
  background: #ffffff;
  border: 1rpx solid #ededf0;
  border-radius: 36rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.enterprise-section-title { margin: 8rpx 0 24rpx; font-size: 34rpx; font-weight: 700; }
.enterprise-muted { color: #6e6e73; }
.enterprise-empty { padding: 100rpx 24rpx; color: #6e6e73; text-align: center; }
.enterprise-button { min-height: 88rpx; color: #fff; background: #0071e3; border: 0; border-radius: 44rpx; font-size: 30rpx; line-height: 88rpx; }
.enterprise-button::after { border: 0; }
.enterprise-button--outline { color: #0071e3; background: #fff; border: 2rpx solid #0071e3; }
.enterprise-form-row { margin-bottom: 28rpx; }
.enterprise-form-label { display: block; margin-bottom: 12rpx; color: #39465b; font-size: 28rpx; font-weight: 600; }
.enterprise-input { min-height: 88rpx; padding: 0 24rpx; background: #f5f5f7; border: 1rpx solid #e5e5ea; border-radius: 20rpx; box-sizing: border-box; }
.enterprise-textarea { width: 100%; min-height: 180rpx; padding: 22rpx 24rpx; background: #f5f5f7; border: 1rpx solid #e5e5ea; border-radius: 20rpx; box-sizing: border-box; }

/* Shared Bento treatment. Page-specific layouts and event bindings remain intact. */
page .enterprise-card,
page .doctor-list-card,
page .project-card,
page .schedule-day-card,
page .item,
page .detail-card {
  border-radius: 36rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, .04);
}
page .doctor-list-card,
page .project-card,
page .item,
page .detail-card { background: #ffffff; }
page .filter-chip,
page .book-small,
page .phone-button,
page .manual-row button,
page .hero-button,
page .consult-card button { border-radius: 999rpx; }
page .filter-chip.active,
page .checkbox.checked { background: #0071e3; border-color: #0071e3; }
page .project-name,
page .doctor-title,
page .package-title,
page .record-head,
page .enterprise-section-title { color: #1d1d1f; }
page .enterprise-card,
page .doctor-list-card,
page .project-card { min-width: 0; box-sizing: border-box; }
page .doctor-info,
page .doctor-main,
page .package-copy { min-width: 0; }
page .record-card,
page .enterprise-card .detail,
page .enterprise-muted { overflow-wrap: anywhere; }
page button { box-sizing: border-box; }
page button:not(.quick-contact-hit):not(.menu-contact-hit) { min-width: 0; white-space: normal; }
