page {
  min-height: 100vh;
  background: #f7f3ef;
  color: #202124;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", Helvetica, Arial, sans-serif;
}

button {
  border-radius: 0;
}

.primary-button {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  color: #ffffff;
  font-size: 34rpx;
  font-weight: 700;
  border: 0;
  background: linear-gradient(90deg, #ff6048, #e91510);
}

.primary-button[disabled] {
  opacity: 0.7;
}
