NODE_ENV=development
PORT=3000
SERVER_BASE_URL=https://api.example.com
FRONTEND_BASE_URL=https://admin.example.com

MYSQL_URL=mysql://wechat_user:CHANGE_ME_PASSWORD@mysql:3306/wechat_appointment
MYSQL_ROOT_PASSWORD=replace-with-mysql-root-password
MYSQL_DATABASE=wechat_appointment
MYSQL_USER=wechat_user
MYSQL_PASSWORD=replace-with-mysql-user-password
REDIS_URL=redis://redis:6379

JWT_SECRET=replace-with-long-random-mini-user-jwt-secret
JWT_EXPIRES_IN=7d
ADMIN_JWT_SECRET=replace-with-long-random-admin-jwt-secret
ADMIN_JWT_EXPIRES_IN=8h

PHONE_ENCRYPTION_KEY=replace-with-32-byte-or-longer-random-string
PHONE_HASH_SALT=replace-with-long-random-phone-hash-salt

MINI_APP_ID=wx-your-mini-app-id
MINI_APP_SECRET=your-mini-app-secret
MINI_MESSAGE_TOKEN=your-mini-program-message-push-token
MINI_SUBSCRIBE_TEMPLATE_APPOINTMENT_SUCCESS=your-mini-subscribe-template-id

OFFICIAL_ACCOUNT_APP_ID=wx-your-official-account-app-id
OFFICIAL_ACCOUNT_APP_SECRET=your-official-account-app-secret
OFFICIAL_ACCOUNT_TOKEN=your-official-account-server-token
OFFICIAL_ACCOUNT_ENCODING_AES_KEY=your-official-account-encoding-aes-key
OFFICIAL_ACCOUNT_TEMPLATE_APPOINTMENT_SUCCESS=your-official-account-template-id

# Optional. Forward successful appointments to the in-hospital follow-up system.
FOLLOWUP_FORWARD_ENABLED=false
FOLLOWUP_FORWARD_URL=https://followup.example.com/api/appointments
FOLLOWUP_FORWARD_AUTH_TOKEN=replace-with-followup-api-token
FOLLOWUP_FORWARD_AUTH_HEADER=Authorization
FOLLOWUP_FORWARD_AUTH_SCHEME=Bearer
FOLLOWUP_FORWARD_TIMEOUT_MS=5000
FOLLOWUP_FORWARD_INCLUDE_FULL_PHONE=true
# JSON object string, for example: {"X-Hospital-Code":"demo"}
FOLLOWUP_FORWARD_EXTRA_HEADERS=

ADMIN_INIT_USERNAME=admin
ADMIN_INIT_PASSWORD=change-this-before-production
ADMIN_INIT_NICKNAME=傅小念

RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=120

CORS_ORIGINS=http://localhost:5173,https://admin.example.com

# Optional. Docker deployment defaults to /app/uploads/landing-assets.
LANDING_ASSET_DIR=/app/uploads/landing-assets
# Optional. Enterprise home, doctor and package images share the existing persistent uploads volume.
ENTERPRISE_ASSET_DIR=/app/uploads/enterprise-assets
