.page {
  min-height: 100vh;
  padding: 28rpx;
  box-sizing: border-box;
}

.item {
  margin-bottom: 22rpx;
  padding: 28rpx;
  background: #ffffff;
  border-radius: 36rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, .04);
}

.top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  gap: 8rpx;
}

.no {
  font-size: 30rpx;
  font-weight: 800;
}

.status {
  color: #d92d20;
  font-weight: 700;
}

.info {
  margin-top: 14rpx;
  color: #4d4d4d;
  font-size: 28rpx;
  overflow-wrap: anywhere;
}

.time {
  margin-top: 14rpx;
  color: #8a8a8a;
  font-size: 24rpx;
}

.empty {
  padding: 160rpx 0 80rpx;
  text-align: center;
  color: #888;
}
