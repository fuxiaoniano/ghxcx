<view class="enterprise-page"><view class="enterprise-card package-head"><image src="{{packageItem.cover}}" mode="aspectFill" /><view><view>{{packageItem.title}}</view><strong>¥{{packageItem.salePrice}}</strong></view></view><view class="enterprise-card"><view class="enterprise-form-row"><text class="enterprise-form-label">姓名（选填）</text><input class="enterprise-input" placeholder="不填则使用个人资料" bindinput="onName" /></view><view class="enterprise-form-row"><text class="enterprise-form-label">联系电话 *</text><view wx:if="{{hasPhone}}" class="phone-ready">已绑定 {{phoneMasked}}</view><view wx:else><button class="phone-button" open-type="getPhoneNumber" bindgetphonenumber="getPhone">微信授权手机号</button><view class="manual-row"><input class="enterprise-input" type="number" maxlength="11" placeholder="或手工输入" bindinput="onManualPhone" /><button bindtap="saveManualPhone">保存</button></view></view></view><view class="enterprise-form-row"><text class="enterprise-form-label">预约日期 *</text><picker mode="date" start="{{today}}" value="{{date}}" bindchange="onDate"><view class="enterprise-input picker-value">{{date || '请选择预约日期'}}</view></picker></view><view class="privacy" bindtap="togglePrivacy"><text class="checkbox {{privacyAccepted?'checked':''}}">{{privacyAccepted?'✓':''}}</text><text>我已阅读并同意隐私协议和用户协议</text></view><button class="enterprise-button" loading="{{submitting}}" disabled="{{submitting}}" bindtap="submit">提交申请</button><view class="tip">提交后客服将在 24 小时内联系您；本页面不收取任何费用。</view></view></view>
