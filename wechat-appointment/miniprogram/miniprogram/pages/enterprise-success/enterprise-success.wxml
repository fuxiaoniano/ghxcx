<view class="enterprise-page success-page"><view class="success-mark">✓</view><view class="success-title">{{appointment.type==='PACKAGE_APPLICATION'?'申请已提交':'预约成功'}}</view><view class="enterprise-muted">请保持电话畅通，工作人员将在 24 小时内与您联系。</view><view class="enterprise-card detail"><view><text>预约编号</text><text>{{appointment.appointmentNo}}</text></view><view wx:if="{{appointment.doctor}}"><text>医生</text><text>{{appointment.doctor.name}}</text></view><view wx:if="{{appointment.package}}"><text>套餐</text><text>{{appointment.package.title}}</text></view><view><text>预约时间</text><text>{{appointment.appointmentDate}} {{appointment.appointmentTime}}</text></view><view><text>医院</text><text>{{appointment.clinic.name || '重庆种博士口腔'}}</text></view><view><text>状态</text><text>{{appointment.statusText}}</text></view></view><button class="enterprise-button" bindtap="goRecords">查看个人中心</button><button class="back-home" bindtap="goHome">返回首页</button></view>
