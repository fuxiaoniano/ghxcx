<view class="mall-page"><view class="mall-search">口腔健康套餐 · 仅提交咨询申请</view><view class="mall-columns"><scroll-view class="mall-categories" scroll-y enhanced show-scrollbar="{{false}}"><view class="mall-category {{activeId===item.id?'active':''}}" wx:for="{{categories}}" wx:key="id" data-id="{{item.id}}" bindtap="selectCategory">{{item.name}}</view></scroll-view><scroll-view class="mall-list" scroll-y enhanced show-scrollbar="{{false}}" refresher-enabled="{{true}}" refresher-triggered="{{refreshing}}" bindrefresherrefresh="refresh"><view wx:if="{{!packages.length}}" class="enterprise-empty">暂无套餐</view><view class="package-card" wx:for="{{packages}}" wx:key="id" data-id="{{item.id}}" bindtap="openDetail"><image src="{{item.cover}}" mode="aspectFill" /><view class="package-copy"><view class="package-title">{{item.title}}</view><view class="sales">{{item.salesCount}} 人已申请</view><view class="prices"><text class="original-price">¥{{item.originalPrice}}</text><strong>¥{{item.salePrice}}</strong></view></view></view></scroll-view></view></view>
