page{background:#f5f5f7}.profile-page{min-height:100vh;overflow:hidden}.profile-hero{padding:60rpx 32rpx 80rpx;color:#fff;background:linear-gradient(145deg,#338ff0,#005bb8);box-sizing:border-box}.hospital-line{overflow:hidden;font-size:28rpx;text-overflow:ellipsis;white-space:nowrap}.user-card{display:flex;min-width:0;align-items:center;gap:22rpx;margin-top:42rpx}.avatar{display:grid;flex:0 0 104rpx;width:104rpx;height:104rpx;place-items:center;color:#0071e3;background:#fff;border-radius:50%;font-size:40rpx;font-weight:700}.user-info{min-width:0;flex:1}.user-name,.user-phone{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.user-name{font-size:36rpx;font-weight:700}.user-phone{margin-top:10rpx;color:#dce8ff}.profile-body{position:relative;margin-top:-42rpx;padding:0 24rpx calc(40rpx + env(safe-area-inset-bottom));box-sizing:border-box}.record-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:4rpx;padding:24rpx 8rpx}.record-grid>view{display:flex;min-width:0;min-height:124rpx;flex-direction:column;align-items:center;justify-content:center;gap:12rpx;padding:0 2rpx;font-size:23rpx;text-align:center;box-sizing:border-box}.record-grid>view>text:last-child{width:100%;white-space:nowrap}.record-icon{display:grid;width:54rpx;height:54rpx;place-items:center;color:#0071e3;background:#e8f2ff;border-radius:18rpx;font-weight:700}.menu-card{overflow:hidden;padding:0}.menu-row{position:relative;display:flex;width:100%;height:100rpx;min-height:100rpx;align-items:center;justify-content:space-between;padding:0 28rpx;color:#1d1d1f;background:#fff;border-bottom:1rpx solid #edf1f6;font-size:28rpx;font-weight:400;line-height:1.4;text-align:left;box-sizing:border-box}.menu-row:last-child{border-bottom:0}.menu-label{display:flex;height:100%;align-items:center}.menu-arrow{flex:0 0 auto;margin-left:20rpx;color:#8c97a8;font-size:28rpx}.menu-contact-hit{position:absolute;z-index:2;top:0;bottom:0;left:28rpx;width:160rpx;height:100%;margin:0;padding:0;opacity:0;border:0}.menu-contact-hit::after{border:0}.follow-card>view:first-child{margin-bottom:10rpx;font-size:30rpx;font-weight:700}.follow-card official-account{display:block;margin-top:22rpx}
