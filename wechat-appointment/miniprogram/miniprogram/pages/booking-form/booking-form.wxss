.form-page{padding-bottom:60rpx}.doctor-summary{display:flex;align-items:center;gap:22rpx;background:#e8f2ff}.doctor-summary image{width:110rpx;height:110rpx;border-radius:18rpx}.doctor-summary view>view{margin-bottom:12rpx;font-size:31rpx;font-weight:700}.doctor-summary view>view text{margin-left:8rpx;color:#68758a;font-size:24rpx;font-weight:400}.picker-value{display:flex;align-items:center}.phone-ready{padding:24rpx;color:#167c61;background:#eaf8f4;border-radius:14rpx}.phone-button{margin:0 0 16rpx;color:#0071e3;background:#e8f2ff;border-radius:14rpx}.manual-row{display:grid;grid-template-columns:1fr 140rpx;gap:14rpx}.manual-row button{height:88rpx;color:#0071e3;background:#fff;border:1rpx solid #0071e3;border-radius:14rpx;line-height:86rpx}.privacy{display:flex;align-items:center;gap:14rpx;margin:30rpx 0;color:#5f6c80;font-size:24rpx}.checkbox{display:grid;width:36rpx;height:36rpx;place-items:center;border:2rpx solid #b6c1d0;border-radius:8rpx}.checkbox.checked{color:#fff;background:#0071e3;border-color:#0071e3}
