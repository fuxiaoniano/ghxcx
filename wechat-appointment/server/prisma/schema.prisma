/// Per-account platform authorization material; values remain encrypted at rest.
model PromotionAccountCredential {
  id                    String           @id @default(cuid()) @db.VarChar(32)
  accountId             String           @unique(map: "pac_account_uq") @db.VarChar(32)
  accessTokenCipher     String?          @db.Text
  clientId              String?          @db.VarChar(255)
  clientSecretCipher    String?          @db.Text
  refreshTokenCipher    String?          @db.Text
  userTokenCipher       String?          @db.Text
