  grantedBy             AdminUser        @relation("PromotionAccountGrantIssuer", fields: [grantedByAdminId], references: [id], onDelete: Restrict, map: "pacg_issuer_fk")

  @@unique([accountId, adminUserId], map: "pacg_account_recipient_uq")
