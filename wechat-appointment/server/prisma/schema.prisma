  statDate   DateTime @db.Date
  periodType String   @default("day") @db.VarChar(12)
  project    String   @db.VarChar(120)
  channel    String   @db.VarChar(80)
  problem    String   @db.VarChar(500)
  adjustment String   @db.VarChar(500)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([statDate, periodType, project, channel])
  @@index([statDate])
  @@map("promotion_daily_report_notes")
}

model WebsiteVisitorDaily {
  id             String   @id @default(cuid()) @db.VarChar(32)
  visitorHash    String   @db.VarChar(64)
  statDate       DateTime @db.Date
  viewCount      Int      @default(1)
  firstPath      String?  @db.VarChar(255)
  lastPath       String?  @db.VarChar(255)
  firstVisitedAt DateTime @default(now())
  lastVisitedAt  DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([visitorHash, statDate])
  @@index([statDate])
  @@index([visitorHash])
  @@map("website_visitor_daily")
}

model ConsultationStatus {
  id        String                     @id @default(cuid()) @db.VarChar(32)
  name      String                     @db.VarChar(60)
  code      String                     @unique @db.VarChar(60)
  color     String                     @default("#457ea9") @db.VarChar(20)
  sort      Int                        @default(0)
  enabled   Boolean                    @default(true)
  category  ConsultationStatusCategory @default(IN_PROGRESS)
  createdAt DateTime                   @default(now())
  updatedAt DateTime                   @updatedAt
  forms     ConsultationForm[]
  followUps ConsultationFollowUp[]

  @@index([enabled, sort])
  @@map("consultation_statuses")
}

model ConsultationTag {
  id               String                @id @default(cuid()) @db.VarChar(32)
  name             String                @unique @db.VarChar(60)
  color            String                @default("#838e7c") @db.VarChar(20)
  sort             Int                   @default(0)
  enabled          Boolean               @default(true)
  createdByAdminId String?               @db.VarChar(32)
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  createdBy        AdminUser?            @relation("ConsultationTagCreator", fields: [createdByAdminId], references: [id], onDelete: SetNull)
  forms            ConsultationFormTag[]

  @@index([enabled, sort])
  @@index([createdByAdminId])
  @@map("consultation_tags")
}

model ConsultationFieldConfig {
  id               String                @id @default(cuid()) @db.VarChar(32)
  name             String                @db.VarChar(80)
  code             String                @unique @db.VarChar(80)
  source           String                @default("CUSTOM") @db.VarChar(16)
  type             ConsultationFieldType @default(TEXT)
  required         Boolean               @default(false)
  enabled          Boolean               @default(true)
  showInForm       Boolean               @default(true)
  showInDetail     Boolean               @default(true)
  showInList       Boolean               @default(false)
  filterable       Boolean               @default(false)
  exportable       Boolean               @default(false)
  importable       Boolean               @default(false)
  listTitle        String?               @db.VarChar(80)
  listOrder        Int                   @default(0)
  listWidth        Int                   @default(140)
  optionsJson      Json?
  createdByAdminId String?               @db.VarChar(32)
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  createdBy        AdminUser?            @relation("ConsultationFieldCreator", fields: [createdByAdminId], references: [id], onDelete: SetNull)

  @@index([source, enabled, listOrder])
  @@index([createdByAdminId])
  @@map("consultation_field_configs")
}

model ConsultationForm {
  id                    String                 @id @default(cuid()) @db.VarChar(32)
  name                  String                 @db.VarChar(64)
  phoneEncrypted        String                 @db.Text
  phoneHash             String                 @db.VarChar(128)
  phoneMasked           String                 @db.VarChar(32)
  projectId             String?                @db.VarChar(32)
  promotionAccountId    String?                @db.VarChar(32)
  channelSource         String                 @db.VarChar(120)
  statusId              String                 @db.VarChar(32)
  ownerAdminId          String                 @db.VarChar(32)
  createdByAdminId      String                 @db.VarChar(32)
  lastOperatedByAdminId String                 @db.VarChar(32)
  recordedAt            DateTime               @default(now())
  lastFollowUpAt        DateTime?
  nextFollowUpAt        DateTime?
  invalidReason         String?                @db.VarChar(500)
  customData            Json?
  duplicateOfId         String?                @db.VarChar(32)
  duplicateReason       String?                @db.VarChar(500)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  project               DentalProject?         @relation(fields: [projectId], references: [id], onDelete: Restrict)
  promotionAccount      PromotionAccount?      @relation(fields: [promotionAccountId], references: [id], onDelete: SetNull)
  status                ConsultationStatus     @relation(fields: [statusId], references: [id], onDelete: Restrict)
  owner                 AdminUser              @relation("ConsultationOwner", fields: [ownerAdminId], references: [id], onDelete: Restrict)
  createdBy             AdminUser              @relation("ConsultationCreator", fields: [createdByAdminId], references: [id], onDelete: Restrict)
  lastOperatedBy        AdminUser              @relation("ConsultationLastOperator", fields: [lastOperatedByAdminId], references: [id], onDelete: Restrict)
  duplicateOf           ConsultationForm?      @relation("ConsultationDuplicates", fields: [duplicateOfId], references: [id], onDelete: SetNull)
  duplicates            ConsultationForm[]     @relation("ConsultationDuplicates")
  followUps             ConsultationFollowUp[]
  tags                  ConsultationFormTag[]

  @@index([phoneHash])
  @@index([projectId])
  @@index([promotionAccountId])
  @@index([statusId])
  @@index([ownerAdminId])
  @@index([createdByAdminId])
  @@index([recordedAt])
  @@index([nextFollowUpAt])
  @@map("consultation_forms")
}

model ConsultationFollowUp {
  id               String              @id @default(cuid()) @db.VarChar(32)
  formId           String              @db.VarChar(32)
  content          String              @db.Text
  resultStatusId   String?             @db.VarChar(32)
  nextFollowUpAt   DateTime?
  createdByAdminId String?             @db.VarChar(32)
  createdAt        DateTime            @default(now())
  form             ConsultationForm    @relation(fields: [formId], references: [id], onDelete: Cascade)
  resultStatus     ConsultationStatus? @relation(fields: [resultStatusId], references: [id], onDelete: SetNull)
  createdBy        AdminUser?          @relation("ConsultationFollowUpCreator", fields: [createdByAdminId], references: [id], onDelete: SetNull)

  @@index([formId, createdAt])
  @@index([createdByAdminId])
  @@map("consultation_follow_ups")
}

model ConsultationFormTag {
  formId    String           @db.VarChar(32)
  tagId     String           @db.VarChar(32)
  createdAt DateTime         @default(now())
  form      ConsultationForm @relation(fields: [formId], references: [id], onDelete: Cascade)
  tag       ConsultationTag  @relation(fields: [tagId], references: [id], onDelete: Restrict)

  @@id([formId, tagId])
  @@index([tagId])
  @@map("consultation_form_tags")
}

model ConsultationImportBatch {
  id              String                    @id @default(cuid()) @db.VarChar(32)
  fileName        String                    @db.VarChar(255)
  status          ConsultationImportStatus  @default(VALIDATED)
  operatorAdminId String?                   @db.VarChar(32)
  totalCount      Int                       @default(0)
  successCount    Int                       @default(0)
  failedCount     Int                       @default(0)
  duplicateCount  Int                       @default(0)
  optionsJson     Json?
  previewJson     Json?
  committedAt     DateTime?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt
  operator        AdminUser?                @relation("ConsultationImportOperator", fields: [operatorAdminId], references: [id], onDelete: SetNull)
  errors          ConsultationImportError[]

  @@index([operatorAdminId, createdAt])
  @@map("consultation_import_batches")
}

model ConsultationImportError {
  id        String                  @id @default(cuid()) @db.VarChar(32)
  batchId   String                  @db.VarChar(32)
  rowNumber Int
  field     String?                 @db.VarChar(80)
  message   String                  @db.VarChar(500)
  rowJson   Json?
  createdAt DateTime                @default(now())
  batch     ConsultationImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([batchId, rowNumber])
  @@map("consultation_import_errors")
}

model ConsultationListPreference {
  id          String    @id @default(cuid()) @db.VarChar(32)
  adminUserId String    @unique @db.VarChar(32)
  columnsJson Json
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@map("consultation_list_preferences")
}
